{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/srnaseq/master/nextflow_schema.json",
    "title": "PerSeqPIPE",
    "description": "Pipeline for sequence-centered quantification of various small non-coding RNAs (sncRNAs) from NGS data",
    "type": "object",
    "$defs": {
      "input_output_options": {
        "type": "object",
        "properties": {
          "input_samplesheet": {
            "type": "string",
            "format": "file-path",
            "description": "Path to input CSV samplesheet."
          },
          "outdir": {
            "type": "string",
            "format": "directory-path",
            "description": "Output directory for pipeline results."
          },
          "publish_dir_mode": {
            "type": "string",
            "enum": ["copy", "symlink", "move"],
            "default": "copy",
            "description": "Mode for publishing results."
          }
        }
      },
      "reference_genome_options": {
        "type": "object",
        "properties": {
          "genome_fasta_file": {
            "type": "string",
            "format": "file-path",
            "description": "Genome FASTA file."
          },
          "index_genome_path": {
            "type": "string",
            "format": "directory-path",
            "description": "Path to STAR genome index."
          },
          "rrna_fasta_file": {
            "type": "string",
            "format": "file-path",
            "description": "FASTA file of rRNA sequences."
          },
          "index_rrna_path": {
            "type": "string",
            "format": "directory-path",
            "description": "Path to STAR rRNA index."
          },
          "index_rrna_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to download prebuilt rRNA STAR index."
          },
          "index_rrna_name": {
            "type": "string",
            "description": "Name of the downloaded rRNA index directory."
          }
        }
      },
      "quantification_flags": {
        "type": "object",
        "properties": {
          "run_firstqc": { "type": "boolean" },
          "run_preprocessing": { "type": "boolean" },
          "run_rrna": { "type": "boolean" },
          "run_mirna": { "type": "boolean" },
          "run_genome": { "type": "boolean" },
          "run_full": { "type": "boolean" }
        },
        "description": "Flags to enable or disable individual pipeline stages."
      },
      "preprocessing_parameters": {
        "type": "object",
        "properties": {
          "error_rate": { "type": "number" },
          "min_overlap": { "type": "integer" },
          "disc_short": { "type": "integer" },
          "num_adapt_to_remove": { "type": "integer" },
          "adapter3_seq": { "type": ["string", "null"] },
          "adapter3_qiaseq_seq1": { "type": "string" },
          "adapter3_qiaseq_seq2": { "type": "string" }
        }
      },
      "mirna_options": {
        "type": "object",
        "properties": {
          "miraligner_db": {
            "type": "string",
            "format": "directory-path",
            "description": "Path to miRAligner database."
          },
          "miraligner_jar": {
            "type": "string",
            "format": "file-path",
            "description": "Path to miraligner.jar."
          }
        }
      },
      "de_analysis_options": {
        "type": "object",
        "properties": {
          "design_file": {
            "type": ["string", "null"],
            "format": "file-path",
            "description": "Design file for differential expression analysis."
          },
          "srna_expression_threshold": {
            "type": "string",
            "pattern": "^\\d+\\,\\d+$",
            "description": "Expression thresholds for samples fpr sRNA, e.g., '20,3' mean at least 20 reads in at least 3 samples."
          },
          "mirna_expression_threshold": {
            "type": "string",
            "pattern": "^\\d+\\,\\d+$",
            "description": "Expression thresholds for samples for miRNA, e.g., '20,3' mean at least 20 reads in at least 3 samples."
          },
          "isomirs_expression_threshold": {
            "type": "string",
            "pattern": "^\\d+\\,\\d+$",
            "description": "Expression thresholds for samples for isomiRs, e.g., '20,3' mean at least 20 reads in at least 3 samples."
          }
        }
      },
      "multiqc_options": {
        "type": "object",
        "properties": {
          "multiqc_config": { "type": ["string", "null"] },
          "multiqc_title": { "type": ["string", "null"] },
          "multiqc_logo": { "type": ["string", "null"] },
          "max_multiqc_email_size": { "type": "string" },
          "multiqc_methods_description": { "type": ["string", "null"] }
        }
      },
      "generic_execution_options": {
        "type": "object",
        "properties": {
          "download_reference_rrna": { "type": "boolean" },
          "download_reference_genome": { "type": "boolean" },
          "lib_type": { "type": "string" },
          "srna_gtf": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "email_on_fail": { "type": ["string", "null"] },
          "plaintext_email": { "type": "boolean" },
          "monochrome_logs": { "type": "boolean" },
          "help": { "type": "boolean" },
          "help_full": { "type": "boolean" },
          "show_hidden": { "type": "boolean" },
          "version": { "type": "boolean" },
          "trace_report_suffix": { "type": "string" },
          "config_profile_name": { "type": ["string", "null"] },
          "config_profile_description": { "type": ["string", "null"] },
          "custom_config_version": { "type": "string" },
          "validate_params": { "type": "boolean" }
        }
      }
    },
    "allOf": [
      { "$ref": "#/$defs/input_output_options" },
      { "$ref": "#/$defs/reference_genome_options" },
      { "$ref": "#/$defs/quantification_flags" },
      { "$ref": "#/$defs/preprocessing_parameters" },
      { "$ref": "#/$defs/mirna_options" },
      { "$ref": "#/$defs/de_analysis_options" },
      { "$ref": "#/$defs/multiqc_options" },
      { "$ref": "#/$defs/generic_execution_options" }
    ],
    "validation": {
        "description": "Check that at least one run_* parameter is true",
        "anyOf": [
          { "properties": { "download_reference_rrna": { "const": true } } },
          { "properties": { "download_reference_genome": { "const": true } } },
          { "properties": { "run_firstqc": { "const": true } } },
          { "properties": { "run_preprocessing": { "const": true } } },
          { "properties": { "run_rrna": { "const": true } } },
          { "properties": { "run_mirna": { "const": true } } },
          { "properties": { "run_genome": { "const": true } } },
          { "properties": { "run_full": { "const": true } } }
        ],
        "errorMessage": "You must specify which modules of PerSeqPIPE to run! Options: --download_reference_rrna, --download_reference_genome, --run_firstqc, --run_preprocessing, --run_rrna, --run_mirna, --run_genome, --run_full"
      }
  }
  