/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests on TriLink dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_trilink,<docker/conda> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile TriLink'
    config_profile_description = 'Minimal test dataset to check pipeline function for TriLink dataset'

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input_samplesheet  = 'https://gitlab.com/Trachtova/test_data/raw/47502259c8d115bcf0f0d2255ba2ce8f2ec144eb/perseqrna/trilink/samplesheet.csv'
    lib_type = 'trilink'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    num_adapt_to_remove        = 1

    // rRNA quantification
    rrna_fasta_file = '/Users/kaja/Public/nextflow/smallrna-seq_nextflow/reference_preparation/reference_files/rRNA/2024_12_30/rRNA_db_custom.fa'
    index_rrna_path = '/Users/kaja/Public/nextflow_results/reference/star_rrna'
 
    // miRNA quantification
    miraligner_db = '/Users/kaja/Public/nextflow/test_data/reference/miraligner_DB_v22'

    // genome quantification
    genome_fasta_file = '/Users/kaja/Public/nextflow/test_data/reference/GRCh38.primary_assembly.genome.fa'

    outdir                       = '/Users/kaja/Public/nextflow_tests/trilink'
    publish_dir_mode             = 'copy'
}