/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ktrachtova/PerSeqPIPE Nextflow config file for running minimal tests on QIAseq dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_qiaseq,<docker> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile QIAseq + MirGeneDB'
    config_profile_description = 'Minimal test dataset to check pipeline function for QIAseq libraries using MirGeneDB reference'

    input_samplesheet          = 'https://raw.githubusercontent.com/ktrachtova/test_data/refs/heads/main/perseqpipe/qiaseq/samplesheet.csv'
    lib_type                   = 'qiaseq'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    quality_filter             = 10
    adapter3_qiaseq_seq1       = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
    adapter3_qiaseq_seq2       = "AACTGTAGGCACCATCAAT"

    sncrna_overlap             = 5
    sncrna_overlap_frac        = null

    outdir                     = null
    publish_dir_mode           = 'copy'

    run_sncrna                 = true

    miraligner_db              = 'mirgenedb'
}