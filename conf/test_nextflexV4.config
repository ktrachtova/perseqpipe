/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests on Nextflex V4 dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_nextflexV4,<docker> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile Nextflex V4'
    config_profile_description = 'Minimal test dataset to check pipeline function for Nextflex V4 libraries'

    input_samplesheet          = 'https://raw.githubusercontent.com/ktrachtova/test_data/refs/heads/main/perseqpipe/nextflexV4/samplesheet.csv'
    lib_type                   = 'nextflexV4'
    adapter3_seq               = 'TGGAATTCTCGGGTGCCAAGG'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    quality_filter             = 10

    run_sncrna                 = true
}