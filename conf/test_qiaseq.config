/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests on QIAseq dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_qiaseq,<docker/conda> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile QIAseq'
    config_profile_description = 'Minimal test dataset to check pipeline function for QIAseq dataset'

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input_samplesheet  = 'https://gitlab.com/Trachtova/test_data/raw/66e47fcbf23f55c604c67846cfa6154e536af1fa/perseqrna/qiaseq/samplesheet.csv'
    lib_type = 'qiaseq'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    num_adapt_to_remove        = 1
    adapter3_qiaseq_seq1       = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
    adapter3_qiaseq_seq2       = "AACTGTAGGCACCATCAAT"

    // rRNA quantification
    index_rrna_name    = 'star_rrna_v1'
    index_rrna_path    = './resources/star_rrna'

    // miRNA quantification
    miraligner_db = '/Users/kaja/Public/nextflow/test_data/reference/miraligner_DB_v22'

    // genome quantification
    genome_fasta_file = '/Users/kaja/Public/nextflow/test_data/reference/GRCh38.primary_assembly.genome.fa'

    outdir                       = '/Users/kaja/Public/nextflow_tests/qiaseq'
    publish_dir_mode             = 'copy'
}