/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ktrachtova/PerSeqPIPE Nextflow config file for running full test (including DE analysis))
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    INTERNAL TEST: Testing full pipeline, 3 conditions with 3 samples each.

    Use as follows:
        nextflow run main.nf -profile docker,test_03 --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile full DE'
    config_profile_description = 'Full test'

    input_samplesheet  = '/Users/kaja/Public/test_data_local/GSE262424_trilink/perseqpipe_tests/samplesheet_de.csv'
    lib_type = 'trilink'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    quality_filter             = 10

    sncrna_overlap             = 5
    sncrna_overlap_frac        = null

    sncrna_expression_threshold = "20,6"
    mirna_expression_threshold = "20,6"
    isomirs_expression_threshold = "20,6"

    publish_dir_mode             = 'copy'

    design_file                  = '/Users/kaja/Public/test_data_local/GSE262424_trilink/perseqpipe_tests/design_de.txt'
    run_full                     = true
}