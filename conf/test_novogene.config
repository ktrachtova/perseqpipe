/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests on Novogene dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test_novogene,<docker/conda> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile Novogene'
    config_profile_description = 'Minimal test dataset to check pipeline function for Novogene dataset'

    input_samplesheet  = 'https://raw.githubusercontent.com/ktrachtova/test_data/refs/heads/add_samplesheets/perseqpipe/novogene/samplesheet.csv'
    lib_type = 'novogene'

    error_rate                 = 0.10
    min_overlap                = 5
    disc_short                 = 15
    quality_filter             = 10

    outdir                       = '/Users/kaja/Public/nextflow_tests/novogene'
    publish_dir_mode             = 'copy'

    run_sncrna                 = true
}